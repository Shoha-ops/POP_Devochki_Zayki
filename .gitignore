# .gitignore for C++ Project

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Compiled Dynamic libraries
*.so
*.so.*
*.dylib
*.dll

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app
*.elf

# Build directories
build/
cmake_build/
dist/
*.cmake

# CMake cache
CMakeFiles/
CMakeCache.txt
cmake_install.cmake

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Debug files
*.dSYM/
*.su
*.gch
*.o.d

# User data
*.txt
*.dat

# Temporary files
*.tmp
temp/

